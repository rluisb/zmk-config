#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        // Rapid USB <-> BT Toggle

        out_toggle {
            bindings = <&out OUT_TOG>;
            key-positions = <11 12>;
            layers = <0 1 2 3>;
            require-prior-idle-ms = <150>;
        };

        // Toggle Fortnite Layer (S symmetric across hands)

        to_fortnite {
            bindings = <&to 5>;
            key-positions = <55 5>;
            layers = <0 1 2 3>;
            require-prior-idle-ms = <150>;
        };

        // Return to base (momentary)

        to_base {
            bindings = <&to 0>;
            key-positions = <55 10>;
            layers = <1 2 3>;
        };

        // Jump to adjust layer

        to_adjust {
            bindings = <&to 3>;
            key-positions = <3 55>;
            layers = <0 1 2 3>;
        };
    };

    behaviors {
        // Timeless home-row mods: opposite-hand chords resolve holds immediately.
        left_home_row: left_home_row {
            compatible = "zmk,behavior-hold-tap";
            label = "LEFT_HOME_ROW";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 54 55 56 57>;
            hold-trigger-on-release;
        };

        right_home_row: right_home_row {
            compatible = "zmk,behavior-hold-tap";
            label = "RIGHT_HOME_ROW";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53>;
            hold-trigger-on-release;
        };

        tap_hold: tap_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_HOLD";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hold_tap: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        space_hold_tap: space_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        layer_hold_tap: layer_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        hold_tap_layer: hold_tap_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&to>;

            quick-tap-ms = <150>;
        };

        td_clipboard: td_clipboard {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_CLIPBOARD";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(C)>, <&kp LG(V)>, <&kp LS(LG(C))>;
        };

        mac_delete_all: mac_delete_all {
            compatible = "zmk,behavior-macro";
            label = "MAC_DELETE_ALL";
            #binding-cells = <0>;
            bindings = <&kp LG(A) &kp BSPC>;
        };

        td_bspc: td_bspc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BSPC";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp BSPC>;
        };

        hold_kr_tap: hold_kr_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_KR_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&key_repeat>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        nav_overlay {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Base layer - Full keyboard with LGui+Num workspace switching
         * LGui+Num works on Windows, Linux, and macOS (⌘+Num = workspace switch)
         */

        base {
            bindings = <
&kp ESCAPE        &hold_tap LA(NUMBER_1) NUMBER_1  &hold_tap LA(NUMBER_2) NUMBER_2  &hold_tap LA(NUMBER_3) NUMBER_3  &hold_tap LA(NUMBER_4) NUMBER_4  &hold_tap LA(NUMBER_5) N5                                                  &hold_tap LA(NUMBER_6) NUMBER_6  &hold_tap LA(NUMBER_7) N7  &hold_tap LA(NUMBER_8) N8  &hold_tap LA(NUMBER_9) N9  &hold_tap LA(NUMBER_0) N0  &kp GRAVE
&kp TAB           &kp Q                            &kp W                            &tap_hold HOME E                 &kp R                            &kp T                                                                      &kp Y                            &kp U                      &tap_hold END I            &kp O                      &kp P                      &hold_kr_tap 0 BACKSPACE
&kp LEFT_SHIFT    &left_home_row LGUI A            &left_home_row LALT S            &left_home_row LEFT_SHIFT D      &left_home_row LEFT_CONTROL F    &kp G                                                                      &kp H                            &right_home_row RIGHT_CONTROL J  &right_home_row RIGHT_SHIFT K    &right_home_row RALT L           &right_home_row RGUI SEMI        &kp SQT
&kp LEFT_CONTROL  &kp Z                            &kp X                            &kp C                            &kp V                            &kp B                      &kp LEFT_BRACKET             &kp RIGHT_BRACKET  &kp N                            &kp M                      &kp COMMA                  &kp DOT                    &kp FSLH                   &kp EQUAL
                                                                                    &td_clipboard                    &kp LEFT_ALT                     &layer_hold_tap 1 LEFT_META  &space_hold_tap LC(SPACE) SPACE  &kp ENTER          &layer_hold_tap 2 DELETE         &kp MINUS                  &kp BACKSLASH
            >;
        };

        lower {
            bindings = <
&kp TILDE         &kp EXCLAMATION  &kp AT  &kp HASH    &kp DOLLAR    &kp PERCENT                         &kp CARET  &kp AMPERSAND  &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&kp F1            &kp F2           &kp F3  &kp F4      &kp F5        &kp F6                              &kp F7     &kp F8         &kp F9         &kp F10               &kp F11                &kp PLUS
&kp LEFT_SHIFT    &trans           &trans  &trans      &trans        &trans                              &trans     &bt BT_SEL 0   &bt BT_SEL 1   &trans                &kp COLON              &kp PIPE
&kp LEFT_CONTROL  &trans           &trans  &trans      &trans        &trans            &trans    &trans  &trans     &trans         &kp LT         &kp GT                &kp QUESTION           &trans
                                           &kp ESCAPE  &kp LEFT_ALT  &kp LEFT_COMMAND  &trans    &trans  &trans     &trans         &kp BACKSLASH
            >;
        };

        raise {
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                    &kp CARET    &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&kp GRAVE  &kp N1           &kp N2       &kp N3    &kp N4      &kp N5                         &kp N6       &kp N7         &kp N8        &kp N9                &kp N0                 &kp KP_PLUS
&kp F1     &kp F2           &kp F3       &kp F4    &kp F5      &kp F6                         &kp LEFT     &kp DOWN       &kp UP_ARROW  &kp RIGHT             &trans                 &trans
&kp F7     &kp F8           &kp F9       &kp F10   &kp F11     &kp F12      &tog 3    &to 0   &kp KP_PLUS  &kp MINUS      &kp EQUAL     &kp LBKT              &kp RBKT               &trans
                                         &trans    &trans      &trans       &to 0     &trans  &trans       &trans         &trans
            >;
        };

        adjust_utility {
            bindings = <
&out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_NXT  &bt BT_PRV  &out OUT_TOG                    &trans  &trans  &trans  &trans  &bt BT_CLR  &bootloader
&trans        &trans        &trans        &trans      &trans      &trans                          &trans  &trans  &trans  &trans  &trans      &trans
&trans        &trans        &trans        &trans      &trans      &trans                          &trans  &trans  &trans  &trans  &trans      &trans
&trans        &trans        &trans        &trans      &trans      &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans      &trans
                                          &trans      &trans      &trans        &trans    &trans  &trans  &trans  &trans
            >;
        };

        nav_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans         &trans       &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans         &trans       &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans         &trans       &trans   &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans
            >;
        };

        FORTNITE {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                      &kp N6  &kp N7  &kp N8  &kp N9  &kp N0    &trans
&trans  &trans  &trans  &kp E   &trans  &trans                                      &trans  &trans  &kp I   &trans  &trans    &trans
&trans  &kp A   &kp S   &kp D   &kp F   &kp G                                       &kp H   &kp J   &kp K   &kp L   &kp SEMI  &trans
&trans  &trans  &trans  &trans  &trans  &trans                 &trans       &trans  &trans  &trans  &trans  &trans  &trans    &trans
                        &trans  &trans  &hold_tap LEFT_META M  &kp SPACE    &trans  &trans  &trans  &trans
            >;
        };
    };
};
